# PostgreSQL connection used by Prisma and the API.
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker?schema=public"

# NestJS API port.
PORT=3000

# Required to generate CV analyses.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Latex compilation service.
LATEX_COMPILER_URL=http://127.0.0.1:3001
LATEX_COMPILER_TIMEOUT_MS=20000
